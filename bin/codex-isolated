#!/usr/bin/env bash
set -euo pipefail

task_repo="$(pwd -P)"
task_uid="$(id -u)"
task_gid="$(id -g)"
task_home="$(realpath -e -- "$HOME")"
notification_bus="/run/user/${task_uid}/bus"
notification_proxy_dir=""
notification_proxy_pid=""
desktop_notification_args=()
read_only_mount_args=()

stop_notification_proxy() {
    if [[ -n "$notification_proxy_pid" ]]; then
        kill "$notification_proxy_pid" 2>/dev/null || true
        wait "$notification_proxy_pid" 2>/dev/null || true
        notification_proxy_pid=""
    fi

    if [[ -n "$notification_proxy_dir" ]]; then
        rm -f -- "${notification_proxy_dir}/bus"
        rmdir -- "$notification_proxy_dir" 2>/dev/null || true
        notification_proxy_dir=""
    fi
}

trap stop_notification_proxy EXIT

if [[ -n "${CODEX_READ_ONLY_PATHS:-}" ]]; then
    IFS=: read -r -a configured_read_only_paths <<< "$CODEX_READ_ONLY_PATHS"
    declare -A mounted_read_only_paths=()

    for read_only_path in "${configured_read_only_paths[@]}"; do
        [[ -n "$read_only_path" ]] || continue

        if [[ "$read_only_path" != /* ]]; then
            echo "CODEX_READ_ONLY_PATHS entries must be absolute: $read_only_path" >&2
            exit 1
        fi
        if [[ ! -e "$read_only_path" ]]; then
            echo "CODEX_READ_ONLY_PATHS entry does not exist: $read_only_path" >&2
            exit 1
        fi
        normalized_read_only_path="$(realpath -m -s -- "$read_only_path")"
        resolved_read_only_path="$(realpath -e -- "$read_only_path")"
        if [[ "$resolved_read_only_path" == "/" || "$resolved_read_only_path" == "$task_home" ]]; then
            echo "Refusing to expose the broad read-only path: $read_only_path" >&2
            exit 1
        fi
        [[ -z "${mounted_read_only_paths[$normalized_read_only_path]:-}" ]] || continue

        read_only_mount_args+=(
            --volume "${normalized_read_only_path}:${normalized_read_only_path}:ro"
        )
        mounted_read_only_paths["$normalized_read_only_path"]=1
    done
fi

if [[ -S "$notification_bus" ]]; then
    if command -v xdg-dbus-proxy >/dev/null; then
        notification_proxy_dir="$(mktemp -d "/run/user/${task_uid}/codex-isolated-dbus.XXXXXX")"
        xdg-dbus-proxy \
            "unix:path=${notification_bus}" \
            "${notification_proxy_dir}/bus" \
            --filter \
            --call=org.freedesktop.Notifications=org.freedesktop.Notifications@/org/freedesktop/Notifications \
            --broadcast=org.freedesktop.Notifications=org.freedesktop.Notifications@/org/freedesktop/Notifications &
        notification_proxy_pid=$!

        for ((proxy_attempt = 0; proxy_attempt < 100; proxy_attempt++)); do
            [[ -S "${notification_proxy_dir}/bus" ]] && break
            kill -0 "$notification_proxy_pid" 2>/dev/null || break
            sleep 0.01
        done

        if [[ -S "${notification_proxy_dir}/bus" ]]; then
            container_notification_dir="/run/user/${task_uid}/codex-isolated-dbus"
            desktop_notification_args=(
                --mount "type=bind,source=${notification_proxy_dir},target=${container_notification_dir},readonly"
                --env "DBUS_SESSION_BUS_ADDRESS=unix:path=${container_notification_dir}/bus"
                --env "XDG_RUNTIME_DIR=${container_notification_dir}"
            )
        else
            echo "Warning: xdg-dbus-proxy failed; native notify-send access is disabled." >&2
            stop_notification_proxy
        fi
    else
        echo "Warning: xdg-dbus-proxy is unavailable; native notify-send access is disabled." >&2
    fi
fi

# The shared Codex configuration invokes the image-installed
# codex-wezterm-notify relay. It sends completion requests through the existing
# terminal with OSC 1337, so no WezTerm control socket needs to be mounted.
codex_args=(
    --sandbox danger-full-access
)

if [[ "$task_repo" == "/" || "$task_repo" == "$HOME" ]]; then
    echo "Refusing to expose the broad directory: $task_repo" >&2
    exit 1
fi

docker run --rm -it \
    --init \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --tmpfs "/tmp:rw,nosuid,nodev,uid=${task_uid},gid=${task_gid}" \
    --tmpfs "/home/oscar/.cache:rw,nosuid,nodev,uid=${task_uid},gid=${task_gid}" \
    --mount "type=bind,source=${task_repo},target=${task_repo}" \
    --mount "type=bind,source=/home/oscar/.codex,target=/home/oscar/.codex" \
    --mount "type=bind,source=/home/oscar/.config/agent-skill-manager,target=/home/oscar/.config/agent-skill-manager" \
    --mount "type=bind,source=/home/oscar/.cache/codex-runtimes,target=/home/oscar/.cache/codex-runtimes" \
    --mount "type=volume,source=codex-isolated-uv-cache,target=/home/oscar/.cache/uv" \
    --mount "type=volume,source=codex-isolated-uv-data,target=/home/oscar/.local/share/uv" \
    --mount "type=bind,source=/usr/lib/chatgpt/resources/codex,target=/usr/lib/chatgpt/resources/codex,readonly" \
    --mount "type=bind,source=/usr/lib/chatgpt/resources/cua_node/bin/node_repl,target=/usr/lib/chatgpt/resources/cua_node/bin/node_repl,readonly" \
    --mount "type=bind,source=/usr/lib/chatgpt/resources/cua_node/lib/node_modules,target=/usr/lib/chatgpt/resources/cua_node/lib/node_modules,readonly" \
    "${read_only_mount_args[@]}" \
    "${desktop_notification_args[@]}" \
    --env HOME=/home/oscar \
    --env CODEX_HOME=/home/oscar/.codex \
    --env COLORTERM \
    --env TERM \
    --env TERM_PROGRAM \
    --env TERM_PROGRAM_VERSION \
    --env WEZTERM_PANE \
    --env TMUX \
    --workdir "${task_repo}" \
    codex-isolated "${codex_args[@]}" "$@"
